{
 "hooks": {
  "PostToolUse": [
   {"matcher": "*", "hooks": [{"type": "command", "command": "cat >> /tmp/s00-hook.jsonl; echo >> /tmp/s00-hook.jsonl"}]},
   {"matcher": "Edit|Write", "hooks": [{"type": "command", "command": "cat >> /tmp/hk.jsonl; echo >> /tmp/hk.jsonl"}]}
  ],
  "PreToolUse": [
   {"matcher": "Bash", "hooks": [{"type": "command", "command": "j=$(cat); printf '%s\\n' \"$j\" >> /tmp/hk.jsonl; if printf '%s' \"$j\" | grep -q 'rm -rf'; then echo 'HKBLOCK: rm -rf is not allowed by the hook' >&2; exit 2; fi; exit 0"}]},
   {"matcher": "mcp__github__.*", "hooks": [{"type": "command", "command": "cat >> /tmp/hk.jsonl; echo >> /tmp/hk.jsonl"}]}
  ],
  "PermissionRequest": [
   {"matcher": "mcp__github__.*", "hooks": [{"type": "command", "command": "cat >> /tmp/hk.jsonl; echo >> /tmp/hk.jsonl"}]}
  ],
  "WorktreeCreate": [
   {"hooks": [{"type": "command", "command": "cat >> /tmp/hk.jsonl; echo >> /tmp/hk.jsonl; mkdir -p /tmp/hkwt2; echo /tmp/hkwt2"}]}
  ],
  "WorktreeRemove": [
   {"hooks": [{"type": "command", "command": "cat >> /tmp/hk.jsonl; echo >> /tmp/hk.jsonl"}]}
  ],
  "ConfigChange": [
   {"hooks": [{"type": "command", "command": "cat >> /tmp/hk.jsonl; echo >> /tmp/hk.jsonl"}]}
  ],
  "DirectoryAdded": [
   {"hooks": [{"type": "command", "command": "cat >> /tmp/hk.jsonl; echo >> /tmp/hk.jsonl"}]}
  ]
 }
}
