{
  "env": {
    "CLAUDE_CODE_ENABLE_TASKS": "0",
    "BASH_DEFAULT_TIMEOUT_MS": "2400000",
    "BASH_MAX_TIMEOUT_MS": "3600000"
  },
  "bashEditDiffEnabled": false,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"$CLAUDE_PROJECT_DIR/.hk\" && { cat; echo; } >> \"$CLAUDE_PROJECT_DIR/.hk/post.jsonl\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"$CLAUDE_PROJECT_DIR/.hk\" && { cat; echo; } >> \"$CLAUDE_PROJECT_DIR/.hk/fail.jsonl\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "KillShell"
    ]
  }
}